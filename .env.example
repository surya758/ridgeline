# Backend API base URL (Phoenix Rising AI).
# Prod custom domain; the raw Azure hostname also works:
#   https://phoenix-rising-ai-api-prod.azurewebsites.net
NEXT_PUBLIC_API_URL=

# Origin sent on server-side inventory fetches; must be a domain registered
# for the org in the API's organization_domains table.
NEXT_PUBLIC_SITE_ORIGIN=
